        // 实现逻辑
    },
    
    bindEvents() {
        // 实现逻辑
    }
};

// 初始化
document.addEventListener('DOMContentLoaded', () => {
    Carousel.init();
});
```

## 调试和日志

### 调试工具
```javascript
// 调试模式
const DEBUG = true;

function debugLog(message, data) {
    if (DEBUG) {
        console.log(`[DEBUG] ${message}`, data);
    }
}

// 性能监控
function measurePerformance(name, fn) {
    const start = performance.now();
    const result = fn();
    const end = performance.now();
    debugLog(`${name} took ${end - start}ms`);
    return result;
}

## Terminal命令执行规范

### 环境判断原则
在执行任何terminal命令前，必须首先判断执行环境：

1统检测**
   - Windows: 使用PowerShell或CMD命令
   - macOS/Linux: 使用bash或zsh命令
   - 避免跨平台命令混用2 **当前工作目录确认**
   - 使用 `pwd` (Linux/macOS) 或 `Get-Location` (PowerShell) 确认当前目录
   - 确保在正确的项目目录中执行命令3. **权限检查**
   - 确认是否有足够的文件系统权限
   - 检查是否需要管理员权限

### Windows环境特殊处理
- **PowerShell语法**：使用 `New-Item` 而不是 `mkdir`
- **路径分隔符**：使用反斜杠 `\` 或正斜杠 `/`
- **命令连接**：使用 `;` 或 `&&` 而不是 `&&`
- **变量语法**：使用 `$variable` 而不是 `$variable`

### 命令执行策略1 **渐进式执行**：先执行简单命令，再执行复杂命令2. **错误处理**：每个命令后检查退出码3 **回退机制**：准备失败时的替代方案4 **用户反馈**：及时告知用户命令执行状态

### 推荐做法
- 优先使用文件操作工具而不是terminal命令
- 对于复杂操作，提供手动步骤说明
- 在命令执行前说明预期结果
- 提供备选方案和故障排除指南

